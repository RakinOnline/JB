<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="vertical">
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="EEEE" android:format24Hour="EEEE"
        android:fontFamily="sans-serif-light" android:textColor="#FF33B5E5" android:textSize="20sp" />
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="d" android:format24Hour="d"
        android:fontFamily="sans-serif-thin" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="84sp" />
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="MMMM yyyy" android:format24Hour="MMMM yyyy"
        android:fontFamily="sans-serif-light" android:textColor="#FFCCCCCC" android:textSize="16sp" />
</LinearLayout>
