<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="vertical">
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="h:mm" android:format24Hour="H:mm"
        android:fontFamily="sans-serif-thin" android:includeFontPadding="false"
        android:textColor="#FFFFFFFF" android:textSize="72sp"
        android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1" />
</LinearLayout>
